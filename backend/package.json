{
  "name": "habit-tracker-backend",
  "version": "1.0.0",
  "description": "Habit Tracker Backend - Node.js/TypeScript REST API with WebSocket",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "test:health": "jest tests/unit/health.test.ts tests/integration/health.routes.test.ts --forceExit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node -r ts-node/register migrations/run.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0",
    "pg": "^8.10.0",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.3.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "zod": "^3.22.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/ws": "^8.5.4",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.45.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
