# ===============================================
# Habit Tracker Backend - Environment Configuration
# ===============================================
# Copy this file to .env and fill in the values
# NEVER commit .env with real secrets to the repository
# ===============================================

# ---- SERVER CONFIGURATION ----
# Environment (development, staging, production)
NODE_ENV=development

# Port to run the server on
PORT=3000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ---- DATABASE CONFIGURATION ----
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habit_tracker_dev

# Database pool configuration (optional)
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ---- JWT / AUTHENTICATION ----
# Secret key for signing JWT tokens
# IMPORTANT: Generate a strong random string for production
# Command to generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production-do-not-share

# JWT Access Token expiry time (in seconds)
# Default: 900 seconds = 15 minutes
JWT_ACCESS_TOKEN_EXPIRY=900

# JWT Refresh Token expiry time (in seconds)
# Default: 604800 seconds = 7 days
JWT_REFRESH_TOKEN_EXPIRY=604800

# ---- OAUTH - GOOGLE ----
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-from-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-console
# Must match the redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# ---- OAUTH - GITHUB ----
# Get these from GitHub Developer Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Must match the Authorization callback URL in GitHub settings
GITHUB_REDIRECT_URI=http://localhost:3000/v1/auth/github/callback

# ---- WEBSOCKET ----
# WebSocket server URL (for client connections)
WS_URL=ws://localhost:3000

# ---- CORS CONFIGURATION ----
# Comma-separated list of allowed origins for CORS
# Include mobile app scheme and web URLs
CORS_ORIGIN=http://localhost:3000,habittracker://,http://localhost:5173

# ---- PRODUCTION SETTINGS ----
# These should only be set to true in production
ENABLE_HTTPS=false
TRUST_PROXY=false
